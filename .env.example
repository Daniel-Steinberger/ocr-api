# Required: clients must send this in the X-API-Key header
API_KEY=change-me

# GPU device (cuda | cpu | mps). marker-pdf reads TORCH_DEVICE.
TORCH_DEVICE=cuda

# Max simultaneous conversions (peak ~5 GB VRAM each on RTX 4070 12 GB)
MAX_CONCURRENT_JOBS=1

# Mute tqdm + HuggingFace download/inference progress bars (recommended in
# production / when stdout is captured by a log aggregator).
DISABLE_PROGRESS_BARS=0
